# ==============================================================================
# SECTION 1: SECRETS & PRIVATE CREDENTIALS (SENSITIVE)
# Copy & paste this block and fill in your private production/staging credentials
# ==============================================================================

# Database Connection (Neon PostgreSQL Pooled / Local SQLite)
# For Postgres (Neon):
DATABASE_URL="postgresql://user:password@ep-sweet-block-pooler.ap-southeast-1.aws.neon.tech/myapp?sslmode=require"
# For Local SQLite:
# DATABASE_URL="file:./dev.db"

# Direct Database Connection (Neon PostgreSQL Direct - bypasses pooler for migrations)
DIRECT_URL="postgresql://user:password@ep-sweet-block.ap-southeast-1.aws.neon.tech/myapp?sslmode=require"

# JWT Authentication Secret (Generate with: openssl rand -hex 64)
JWT_SECRET="your-64-character-hex-jwt-secret-string-here"

# Resend API Key (Get your key from https://resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key_here"

# Cloudinary Media Storage Secret
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Google OAuth Secret
GOOGLE_CLIENT_SECRET="your-google-client-secret"


# ==============================================================================
# SECTION 2: CONFIGURATION & PUBLIC SETTINGS (NON-SENSITIVE)
# App URLs, public IDs, token expiry, and telemetry flags
# ==============================================================================

# Application & Network URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# JWT Expiration Period
JWT_EXPIRES_IN="7d"

# Resend Email Sender Settings
# Free testing sender is onboarding@resend.dev (sends to verified account owner)
EMAIL_FROM="Poppin <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Poppin <onboarding@resend.dev>"

# Cloudinary Public Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your_cloudinary_api_key"

# Google OAuth Public Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Next.js Telemetry Flag
NEXT_TELEMETRY_DISABLED=1
