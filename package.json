{
  "name": "poppin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate:sqlite": "node scripts/prisma-sqlite.js generate",
    "db:generate:postgres": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "db:migrate:sqlite": "node scripts/prisma-sqlite.js migrate dev",
    "db:migrate:postgres": "prisma migrate dev --schema=prisma/postgresql/schema.prisma",
    "db:push:sqlite": "node scripts/prisma-sqlite.js db push",
    "db:push:postgres": "prisma db push --schema=prisma/postgresql/schema.prisma",
    "db:studio:sqlite": "node scripts/prisma-sqlite.js studio",
    "db:studio:postgres": "prisma studio --schema=prisma/postgresql/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "prisma:postgres": "prisma generate --schema=prisma/postgresql/schema.prisma",
    "prisma:postgres:migrate": "prisma migrate dev --schema=prisma/postgresql/schema.prisma",
    "prisma:postgres:push": "prisma db push --schema=prisma/postgresql/schema.prisma",
    "prisma:migrate": "node scripts/prisma-sqlite.js migrate dev",
    "prisma:push": "node scripts/prisma-sqlite.js db push",
    "ws": "tsx server/websocket.ts",
    "realtime:dev": "npm run --prefix realtime-server dev",
    "realtime:build": "npm run --prefix realtime-server build",
    "realtime:start": "npm run --prefix realtime-server start",
    "realtime:test": "npx tsx tests/realtime-socket.test.ts",
    "db:seed:postgres": "tsx scripts/seed-postgresql.ts",
    "seed": "tsx scripts/seed-postgresql.ts",
    "test": "npx tsx tests/run-all.ts"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.22.0",
    "@types/ws": "^8.18.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "gsap": "^3.15.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.71.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.38.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ui-ux-pro-max-cli": "^2.15.0",
    "uipro-cli": "^2.2.3",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
