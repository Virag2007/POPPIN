{
  "info": {
    "name": "POPPIN - Identity & User Management API (v1)",
    "description": "Complete Postman collection for Developer 1 API endpoints: Auth, Profiles, Onboarding, Connections, Account Settings & Safety.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Get Authenticated User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset-token>\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Google OAuth Start",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/google"
          }
        },
        {
          "name": "Google OAuth Callback",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/google/callback?code=<oauth_code>"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "User Profiles",
      "item": [
        {
          "name": "Check Username Availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usernames/availability?username=john_doe"
          }
        },
        {
          "name": "Create Own Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"displayName\": \"John Doe\",\n  \"headline\": \"Software Engineer\",\n  \"bio\": \"Hello world!\",\n  \"location\": \"San Francisco, CA\"\n}"
            }
          }
        },
        {
          "name": "Get Own Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me/profile"
          }
        },
        {
          "name": "Update Own Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headline\": \"Senior Software Engineer\",\n  \"location\": \"New York, NY\"\n}"
            }
          }
        },
        {
          "name": "Get Public Profile by Username",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/profiles/john_doe"
          }
        },
        {
          "name": "Update Skills",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile/skills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\"TypeScript\", \"Next.js\", \"Tailwind\"]\n}"
            }
          }
        },
        {
          "name": "Update Interests",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile/interests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interests\": [\"Open Source\", \"Design Systems\"]\n}"
            }
          }
        },
        {
          "name": "Update External Links",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile/links",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"links\": [\n    { \"title\": \"GitHub\", \"url\": \"https://github.com/johndoe\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Education",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile/education",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"education\": [\n    { \"school\": \"Stanford University\", \"degree\": \"B.S.\", \"fieldOfStudy\": \"Computer Science\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Experience",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/profile/experience",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"experience\": [\n    { \"company\": \"Tech Corp\", \"title\": \"Software Engineer\", \"current\": true }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Get Onboarding Progress",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/onboarding"
          }
        },
        {
          "name": "Save Step 1 (Role & Headline)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/onboarding/step-1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Backend Engineer\",\n  \"headline\": \"Distributed Systems Enthusiast\"\n}"
            }
          }
        },
        {
          "name": "Save Step 2 (Skills & Interests)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/onboarding/step-2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\"Go\", \"TypeScript\"],\n  \"interests\": [\"Cloud Architecture\"]\n}"
            }
          }
        },
        {
          "name": "Get Follow Suggestions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/onboarding/follow-suggestions"
          }
        },
        {
          "name": "Complete Onboarding",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/onboarding/complete"
          }
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/:userId/follow"
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/:userId/follow"
          }
        },
        {
          "name": "Get User Followers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/:userId/followers?limit=20&offset=0"
          }
        },
        {
          "name": "Get User Following",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/:userId/following?limit=20&offset=0"
          }
        },
        {
          "name": "Get Own Followers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me/followers"
          }
        },
        {
          "name": "Get Own Following",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me/following"
          }
        },
        {
          "name": "Get Suggested People",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/suggestions"
          }
        }
      ]
    },
    {
      "name": "Account Settings & Safety",
      "item": [
        {
          "name": "Get Account Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me/account"
          }
        },
        {
          "name": "Update Account Email",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new_email@example.com\"\n}"
            }
          }
        },
        {
          "name": "Get Privacy Settings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me/privacy"
          }
        },
        {
          "name": "Update Privacy Settings",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/me/privacy",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPrivate\": true,\n  \"showActivityStatus\": false,\n  \"allowTagging\": true\n}"
            }
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/:userId/block"
          }
        },
        {
          "name": "Unblock User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/:userId/block"
          }
        },
        {
          "name": "Report User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/:userId/report",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"SPAM\",\n  \"details\": \"Automated bot behavior\"\n}"
            }
          }
        },
        {
          "name": "Delete Own Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    }
  ]
}

