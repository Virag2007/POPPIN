# =================================================================
# POPPIN Real-Time Server (Railway Deployment Configuration)
# =================================================================

# Server Port (Railway automatically sets PORT; default 4000)
PORT=4000
HOST="0.0.0.0"
NODE_ENV="production"

# Database Connection (Neon PostgreSQL pooled connection string)
DATABASE_URL="postgresql://user:password@ep-sweet-block-pooler.ap-southeast-1.aws.neon.tech/myapp?sslmode=require"

# JWT Authentication Secret (Must match Next.js main app JWT_SECRET)
JWT_SECRET="69f395fe4162d5d04e397fd751afd0bc433925dc9aa1b28bdd15aec60340d3a894b305bd572853a49ec939d5e0fd2a9f83bc873c96dee7427f599e5131ca4c60"

# Strict CORS: Comma-separated list of allowed frontend origins
# E.g. Vercel deployment URL and local development
ALLOWED_ORIGINS="http://localhost:3000,https://poppin.vercel.app,https://your-custom-domain.com"

# Optional Redis URL for horizontal clustering across multiple Railway instances
# REDIS_URL="redis://default:password@ep-redis.railway.internal:6379"

